# ---------------------------------------------------------------
# MariStay environment configuration (copy to .env and edit)
# Never commit the real .env file.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# MySQL connection (XAMPP / MySQL Server / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=maristay_db

# JWT — use a long random value (at least 32 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# Allowed browser origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# Password given to every seeded demo account (min 8 chars, letters + numbers).
# Only used by `npm run seed`; it is hashed with bcrypt before insertion.
SEED_DEMO_PASSWORD=replace_with_a_local_demo_password

# Database used by `npm run test:e2e` (must end with _test; it is recreated on every run)
TEST_DB_DATABASE=maristay_test_db
