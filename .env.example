# Application configuration
NODE_ENV=development
PORT=3000

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=maristay_db

# JWT configuration
# Use a secure random secret with at least 32 characters.
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# Demo account password
SEED_DEMO_PASSWORD=replace_with_a_local_demo_password

# Isolated test database
# Recreated during end-to-end testing.
TEST_DB_DATABASE=maristay_test_db