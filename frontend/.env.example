# MariStay frontend configuration (copy to .env.local).
# Only public values belong here: everything prefixed with VITE_ is bundled
# into the browser code. Never put database credentials, JWT secrets or
# demo passwords in this file.

# Backend REST API base URL.
#   Normal development (npm run start:dev):         http://localhost:3000/api/v1
#   Isolated integration testing (postman:start):   http://localhost:3001/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1
