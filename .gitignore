# Dependencies
node_modules/

# Build output
dist/
dist-postman/
build/
coverage/
*.tsbuildinfo

# Environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# OS / editor temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Private reference material (laboratory PDFs) — not part of the submitted source
references/

# Final submission documents (submitted separately, kept locally)
docs/MariStay_Final_Project_Documentation.docx
docs/MariStay_Final_Project_Documentation.pdf
docs/VIDEO_DEMO_SCRIPT.md
docs/TESTING_REPORT.md
docs/DEFENSE_QUESTIONS.md
docs/MariStay_Final_Documentation.docx
/docs/reference/

# Microsoft Word temporary lock files
~$*.docx

# Private development brief (kept locally, not published)
MASTER_PROMPT.md

# Postman: only the exported collection and environment are tracked.
# Desktop file-sync folders (collections/, environments/, globals/ ...), the
# workspace id and generated files in postman/tmp/ may hold tokens and stay local.
/postman/*
!/postman/MariStay.postman_collection.json
!/postman/MariStay.postman_environment.json
.postman/
*.postman_environment.local.json
*.environment.yaml

# Former exports/ folder (local temporary files and backups only)
/exports/

# Database backups (contain password hashes)
*.sql.bak
*backup*.sql

# Claude Code local settings
.claude/settings.local.json

# Generated documentation build output (HTML preview)
docs/build/
